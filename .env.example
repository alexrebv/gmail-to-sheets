# ============================================================
# ОБЯЗАТЕЛЬНО
# ============================================================
# ID Google Таблицы из URL: /spreadsheets/d/<ID>/edit
SPREADSHEET_ID=your_spreadsheet_id

# ============================================================
# Gmail OAuth2 (Вариант A — личный Gmail)
# ============================================================
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# ============================================================
# Service Account (Вариант B — Google Workspace)
# ============================================================
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GMAIL_IMPERSONATE_EMAIL=user@yourdomain.com

# ============================================================
# База (необязательно)
# ============================================================
# DATABASE_URL — своя база сервиса (в Railway: ${{Postgres.DATABASE_URL}}).
# DATABASE_URL=postgres://...
#
# UCHET_DATABASE_URL — база приложения-учёта, если она НЕ та же. Оттуда
# берётся прайс-лист для полного бланка: его заливают и правят в приложении
# (раздел «Учёт» → «Прайс-лист»). Не задана — берём DATABASE_URL, а если и его
# нет, прайс читается из Google Таблицы, как раньше.
# UCHET_DATABASE_URL=postgres://...

# ============================================================
# Все остальные настройки (токен TG, расписания, даты)
# хранятся в листе «Настройки» Google Таблицы.
# В Railway достаточно указать только SPREADSHEET_ID + Gmail credentials.
#
# Про прайс в листе «Настройки»:
#   PRICELIST_SOURCE          «база» или «таблица» - выбрать источник руками.
#                             По умолчанию сначала база, потом таблица.
#   FULL_BLANK_SUPPLIERS      кому слать полный бланк (по умолчанию Булки ПРО).
#   PRICELIST_SPREADSHEET_ID  таблица с прайсом, если читаем из таблицы.
#   SHEET_PRICELIST           имя листа с прайсом (по умолчанию PriceList).
# ============================================================
